# Server-side email settings
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="AICS Lab <onboarding@resend.dev>"
CONTACT_TO_EMAIL=your-resend-account@gmail.com

# PostgreSQL content seed
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aics
PGSSLMODE=disable

# Public content API
# Production: the deployed lab-hub backend origin, without a trailing slash.
VITE_API_BASE_URL=
# Local Vite proxy target.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
